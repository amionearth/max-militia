# Front end (Vite, build time). Leave empty for local play: the client then uses ws://<host>:8787.
# On Vercel set this to the public WebSocket URL of the game server (wss://...).
VITE_WS_URL=

# Game server (server/index.ts)
PORT=8787
# Comma separated browser origins allowed to connect. Empty = allow any origin (local development only).
ALLOWED_ORIGINS=
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=6
MAX_CONNECTIONS_PER_IP=12
